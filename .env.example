# ==============================================================
# 12. Upstream News API - Configurações Centrais e Bases
# Ambas as APIs fornecem as mesmas notícias e fontes reformuladas
# ==============================================================
NEWS_API_BASE_URL=https://news-sources-api.vercel.app
NEWS_API_FALLBACK_BASE_URL=https://api-news-media.netlify.app
NEWS_API_KEY=bn_88feb5baa3f84955677e8c11453aae352811b9fe6c3398cd
NEWS_API_ENDPOINT_LIST_ALL_SOURCES=/api/news
NEWS_API_ENDPOINT_CATEGORY_BY_NAME=/api/news/category/{categoria}
NEWS_API_ENDPOINT_CATEGORY_BY_SLUG=/api/news/category/{slug}
