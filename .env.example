NEWS_API_ENDPOINT_CATEGORIES=/api/categories
NEWS_API_ENDPOINT_TYPES=/api/types
NEWS_API_ENDPOINT_STATS=/api/stats
NEWS_API_ENDPOINT_OPENAPI_SPEC=/api/openapi.json

