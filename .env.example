# ==============================================================
# Arquivo de variáveis de ambiente - normajuridica.com.br
# Preencha os valores reais antes de rodar em desenvolvimento
# ou publicar em produção. NUNCA suba este arquivo para o Git.
# ==============================================================

# --------------------------------------------------------------
# 1. Inteligência Artificial e Plataforma
# --------------------------------------------------------------
# GEMINI_API_KEY: Usada para processamento editorial e inteligência artificial.
# No AI Studio, é injetada automaticamente via painel de Secrets.
GEMINI_API_KEY=

# APP_URL: Endereço completo onde o aplicativo está hospedado.
# No AI Studio, é injetada automaticamente com a URL do Cloud Run.
APP_URL=

# --------------------------------------------------------------
# 2. Domínio e Roteamento
# --------------------------------------------------------------
# NEXT_PUBLIC_DOMAIN / VITE_SITE_URL: Domínio canônico do portal (dev ou produção)
NEXT_PUBLIC_DOMAIN=https://normajuridica.com.br
VITE_SITE_URL=https://normajuridica.com.br
VITE_APP_URL=https://normajuridica.com.br

# API Upstream de Notícias e Mídia
API_KEY=

# --------------------------------------------------------------
# 3. Google AdSense (Monetização)
# --------------------------------------------------------------
# NEXT_PUBLIC_ADSENSE_ID: ID do anunciante AdSense (formato ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# Aliases retrocompatíveis para AdSense
GOOGLE_ADSENSE_CLIENT_ID=
GOOGLE_ADSENSE_SLOT_HEADER=
GOOGLE_ADSENSE_SLOT_SIDEBAR=
GOOGLE_ADSENSE_SLOT_SIDEBAR_BOTTOM=
GOOGLE_ADSENSE_SLOT_IN_ARTICLE=
GOOGLE_ADSENSE_SLOT_FOOTER=
VITE_GOOGLE_ADSENSE_CLIENT_ID=
VITE_GOOGLE_ADSENSE_SLOT_HEADER=
VITE_GOOGLE_ADSENSE_SLOT_SIDEBAR=
VITE_GOOGLE_ADSENSE_SLOT_SIDEBAR_BOTTOM=
VITE_GOOGLE_ADSENSE_SLOT_IN_ARTICLE=
VITE_GOOGLE_ADSENSE_SLOT_FOOTER=

# --------------------------------------------------------------
# 4. Google Analytics (Métricas de Audiência)
# --------------------------------------------------------------
# NEXT_PUBLIC_GA_MEASUREMENT_ID: ID de métricas do Google Analytics 4 (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --------------------------------------------------------------
# 5. Servidor SMTP (Formulário de Contato e Ouvidoria)
# --------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=seu-email@gmail.com
SMTP_TO=destino@gmail.com

# Aliases de e-mail complementares
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=
GOOGLE_APP_PASSWORD=

# --------------------------------------------------------------
# 6. Firebase Realtime Database & Auth - PROJETO 1 (Principal)
# --------------------------------------------------------------
# Credenciais do Projeto Principal no Firebase (limite gratuito de 10 GB/mês).
# O banco armazena o acervo dinâmico em /news e métricas em /traffic_stats.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Aliases Vite para o Projeto 1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --------------------------------------------------------------
# 7. Firebase Realtime Database - PROJETO 2 (Espelho / Rotação de Tráfego)
# --------------------------------------------------------------
# Segundo projeto Firebase independente (com outros 10 GB/mês gratuitos).
# Os dados são espelhados entre as instâncias, e o sistema de rotação alterna
# as leituras automaticamente assim que o Projeto 1 se aproximar de 9 GB.
NEXT_PUBLIC_FIREBASE_2_API_KEY=
NEXT_PUBLIC_FIREBASE_2_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_2_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_2_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_2_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_2_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_2_APP_ID=

# Aliases Vite para o Projeto 2
VITE_FIREBASE_2_API_KEY=
VITE_FIREBASE_2_AUTH_DOMAIN=
VITE_FIREBASE_2_DATABASE_URL=
VITE_FIREBASE_2_PROJECT_ID=
